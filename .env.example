NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=local-development-only
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_MAX_RECEIVE_COUNT=5
SQS_WAGER_TRANSACTION_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_TRANSACTION_DLQ_NAME=wager-transactions-dlq.fifo
SQS_WAGER_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_WAIT_TIME_SECONDS=20
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=60
SQS_CONSUMER_SHUTDOWN_TIMEOUT_MS=15000
REFERENCE_RETRY_BASE_DELAY_MS=1000
REFERENCE_RETRY_MAX_ATTEMPTS=8
REFERENCE_RETRY_BATCH_SIZE=50
REFERENCE_RETRY_POLL_INTERVAL_MS=1000
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_PUBLISHER_BATCH_SIZE=25
OUTBOX_PUBLISHER_POLL_INTERVAL_MS=1000
OUTBOX_PUBLISHER_RETRY_BASE_DELAY_MS=1000
OUTBOX_PUBLISHER_RETRY_MAX_DELAY_MS=60000
OUTBOX_PUBLISHER_SHUTDOWN_TIMEOUT_MS=15000
DEPENDENCY_TIMEOUT_MS=3000
